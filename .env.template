# Backend / FastAPI
HOST=0.0.0.0
PORT=5000

# Force CPU-only execution (no GPU/CUDA)
# CUDA_VISIBLE_DEVICES=
TORCH_DEVICE=cpu

# PostgreSQL - Use your external database credentials (Zeabur, AWS RDS, etc.)
POSTGRES_HOST=sjc1.clusters.zeabur.com
POSTGRES_USER=root
POSTGRES_DB=zeabur
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_PORT=22463

# Frontend host for CORS and email links
# Development: http://localhost:5173
# Production: Override in docker-compose.prod.yml to http://localhost
FRONTEND_HOST=http://localhost:5173

# LLM API Keys (Required for chatbot and RAG functionality)
# IMPORTANT: These keys should be configured on the server side for security
GEMINI_API_KEY=your-gemini-api-key-here  # Required - Get from https://makersuite.google.com/app/apikey
# OPENAI_API_KEY=your-openai-api-key-here    # Optional - for OpenAI models
# ANTHROPIC_API_KEY=your-anthropic-api-key-here  # Optional - for Claude models

# TODO: There are bugs when using search tools. 
# Search API Keys (at least one recommended for enhanced search)
# SERPER_API_KEY=                    # Optional - Google Search via Serper (https://serper.dev)
# TAVILY_API_KEY=                    # Optional - Tavily Search (https://tavily.com)

# Default LLM Provider (options: gemini, openai, anthropic)
DEFAULT_LLM_PROVIDER=gemini

# Gemini File Search Configuration (for RAG)
GEMINI_FILE_SEARCH_MODEL=gemini-2.5-flash-lite  # Model for RAG queries (options: gemini-2.5-flash-lite, gemini-2.5-pro)
GEMINI_STORE_SIZE_LIMIT_GB=20                 # Recommended size limit per store (GB)
GEMINI_MAX_FILE_SIZE_MB=100                   # Max file size for upload (MB)

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate a secure random string for production (e.g., using: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-please-change-in-production
EXPIRES_DELTA=30

# Gmail SMTP Configuration (Optional - for password reset and verification emails)
# To use Gmail SMTP, you need to:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your regular Gmail password) below
FROM_EMAIL=your-email@gmail.com           # Gmail address to send emails from
GMAIL_APP_PASSWORD=your-app-password-here # Gmail App Password (16 characters without spaces)

# Optional: Debug mode (default: false in production)
# DEBUG=true

# Optional: Allowed CORS origins (comma-separated, defaults to FRONTEND_HOST)
# For production, include both dev and prod origins:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://localhost:80

# Redis Configuration (for rate limiting)
# For Docker: use 'redis' as hostname (docker-compose service name)
# For local development: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=  # Optional - uncomment if Redis requires authentication
REDIS_DB=0

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true              # Enable/disable rate limiting
RATE_LIMIT_MESSAGES=20               # Maximum messages per time window
RATE_LIMIT_WINDOW_SECONDS=1800       # Time window in seconds (1800 = 30 minutes)

GUNICORN_WORKERS=4