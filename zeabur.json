{
  "$schema": "https://zeabur.com/schema.json",
  "name": "RAG Chat Application",
  "services": [
    {
      "type": "git",
      "name": "app",
      "icon": "💬",
      "ports": [
        {
          "id": "web",
          "port": 8080,
          "type": "HTTP"
        }
      ],
      "env": {
        "ENVIRONMENT": {
          "default": "production",
          "description": "Application environment"
        },
        "DEBUG": {
          "default": "False",
          "description": "Debug mode (True/False)"
        },
        "SECRET_KEY": {
          "description": "Secret key for JWT tokens (min 32 chars)",
          "required": true
        },
        "GEMINI_API_KEY": {
          "description": "Google Gemini API key for LLM and RAG",
          "required": true
        },
        "DATABASE_URL": {
          "description": "PostgreSQL connection string",
          "required": true
        },
        "FRONTEND_HOST": {
          "description": "Frontend URL for CORS and email links",
          "required": true
        },
        "OPENAI_API_KEY": {
          "description": "OpenAI API key (optional)",
          "required": false
        },
        "ANTHROPIC_API_KEY": {
          "description": "Anthropic API key (optional)",
          "required": false
        },
        "GUNICORN_WORKERS": {
          "default": "4",
          "description": "Number of Gunicorn worker processes"
        }
      }
    },
    {
      "type": "postgresql",
      "name": "database",
      "icon": "🐘"
    }
  ],
  "networks": [
    {
      "name": "app-network",
      "services": ["app", "database"]
    }
  ]
}
