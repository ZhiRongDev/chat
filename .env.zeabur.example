# ================================================
# Zeabur Environment Variables Template
# Copy these to your Zeabur service configuration
# ================================================

# -------------------- Database --------------------
# Get these from your Zeabur PostgreSQL service
DATABASE_URL=postgresql://username:password@host:port/database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=chat_db
POSTGRES_HOST=your-postgres-host.zeabur.internal
POSTGRES_PORT=5432

# -------------------- Security --------------------
# Generate a strong secret key (min 32 characters)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------- Required API Keys --------------------
# Required for RAG functionality
GEMINI_API_KEY=your-gemini-api-key-here

# -------------------- Optional API Keys --------------------
# Only needed if using these providers
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# -------------------- Application Settings --------------------
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=RAG Chat Application
HOST=0.0.0.0
PORT=5000

# -------------------- CORS & Frontend --------------------
# Update with your actual Zeabur domain
FRONTEND_HOST=https://your-app.zeabur.app

# -------------------- LLM Configuration --------------------
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_GEMINI_MODEL=gemini-2.5-flash-lite
DEFAULT_OPENAI_MODEL=gpt-4-turbo-preview
DEFAULT_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------- Gemini File Search --------------------
GEMINI_FILE_SEARCH_MODEL=gemini-2.5-flash-lite
GEMINI_STORE_SIZE_LIMIT_GB=20
GEMINI_MAX_FILE_SIZE_MB=100

# -------------------- Email Configuration --------------------
# Optional: For password reset functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# -------------------- Gunicorn Workers --------------------
# Adjust based on Zeabur instance resources
# Formula: (2 x CPU cores) + 1
GUNICORN_WORKERS=4
