# Backend / FastAPI
HOST=0.0.0.0
PORT=5000

# Force CPU-only execution (no GPU/CUDA)
# CUDA_VISIBLE_DEVICES=
TORCH_DEVICE=cpu

# PostgreSQL - For Docker use 'db', for local use 'localhost'
DB_HOST=localhost      # Use 'db' for Docker, 'localhost' for local development
DB_USER=postgres
DB_NAME=chat_dev
DB_PASSWORD=postgres
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chat_dev

# Redis - For Docker use 'redis', for local use 'localhost'
REDIS_HOST=localhost   # Use 'redis' for Docker, 'localhost' for local development
REDIS_PORT=6379
REDIS_DB=0

# Frontend host for CORS
FRONTEND_HOST=http://localhost:5173

# LLM API Keys (Optional - can also be provided via frontend settings)
# Leave empty if you want users to provide their own API keys via the UI
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Search API Keys (at least one recommended for enhanced search)
# SERPER_API_KEY=                    # Optional - Google Search via Serper (https://serper.dev)
# TAVILY_API_KEY=                    # Optional - Tavily Search (https://tavily.com)

# Default LLM Provider (options: gemini, openai, anthropic)
DEFAULT_LLM_PROVIDER=gemini

# Gemini File Search Configuration (for RAG)
GEMINI_FILE_SEARCH_MODEL=gemini-2.5-flash-lite  # Model for RAG queries (options: gemini-2.5-flash-lite, gemini-2.5-pro)
GEMINI_STORE_SIZE_LIMIT_GB=20                 # Recommended size limit per store (GB)
GEMINI_MAX_FILE_SIZE_MB=100                   # Max file size for upload (MB)

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
SECRET_KEY=change-this-secret-key-in-production-please-use-a-random-string
EXPIRES_DELTA=30

# Email Configuration
FROM_EMAIL=your-email@gmail.com  # Email address to send password reset and verification emails from

# Optional: Debug mode (default: false in production)
# DEBUG=true

# Optional: Allowed CORS origins (comma-separated, defaults to FRONTEND_HOST)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

